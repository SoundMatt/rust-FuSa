      "tool": {
        "driver": {
          "name": "rust-FuSa",
          "rules": [
            {
              "id": "ANA001",
              "properties": {
                "category": "safety"
              },
              "shortDescription": {
                "text": "break the function into smaller, focused functions to aid review and certification"
              }
            },
            {
              "id": "ANA002",
              "properties": {
                "category": "safety"
              },
              "shortDescription": {
                "text": "extract deeply nested blocks into helper functions"
              }
            },
            {
              "id": "ANA004",
              "properties": {
                "category": "safety",
                "clause": "EXP34-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "add '//fusa:unsafe <justification>' before the dereference"
              }
            },
            {
              "id": "ANA005",
              "properties": {
                "category": "safety",
                "clause": "6.4.6",
                "standard": "iso26262"
              },
              "shortDescription": {
                "text": "use try_from() / try_into() to detect overflow, or add '// safe: <range-proof>' comment"
              }
            },
            {
              "id": "ANA006",
              "properties": {
                "category": "safety"
              },
              "shortDescription": {
                "text": "restructure with a single exit point or use the ? operator to simplify control flow"
              }
            },
            {
              "id": "CYBER001",
              "properties": {
                "category": "security",
                "clause": "11.4.3",
                "standard": "iso21434"
              },
              "shortDescription": {
                "text": "load credentials from environment variables or a secrets manager"
              }
            },
            {
              "id": "CYBER002",
              "properties": {
                "category": "security",
                "clause": "STR02-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "use parameterised queries (? placeholders) instead of string concatenation"
              }
            },
            {
              "id": "CYBER003",
              "properties": {
                "category": "security",
                "clause": "FIO02-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "call .canonicalize() and verify the result is within the allowed root"
              }
            },
            {
              "id": "CYBER004",
              "properties": {
                "category": "security",
                "clause": "11.4.3",
                "standard": "iso21434"
              },
              "shortDescription": {
                "text": "use OsRng or the rand::rngs::OsRng for cryptographic randomness"
              }
            },
            {
              "id": "CYBER005",
              "properties": {
                "category": "security",
                "clause": "INT30-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "use .checked_add() / .checked_mul() to prevent integer overflow"
              }
            },
            {
              "id": "CYBER006",
              "properties": {
                "category": "security",
                "clause": "7.3.3",
                "standard": "unece-r155"
              },
              "shortDescription": {
                "text": "use HTTPS to encrypt data in transit"
              }
            },
            {
              "id": "CYBER010",
              "properties": {
                "category": "security",
                "clause": "STR38-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "validate structure and field bounds after deserialisation before use"
              }
            },
            {
              "id": "CYBER011",
              "properties": {
                "category": "security",
                "clause": "ARR30-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "use .get(index) which returns Option instead of panicking on out-of-bounds"
              }
            },
            {
              "id": "CYBER012",
              "properties": {
                "category": "security",
                "clause": "MEM35-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "cap allocations with a constant maximum (e.g., .min(MAX_CAPACITY))"
              }
            },
            {
              "id": "CYBER013",
              "properties": {
                "category": "security",
                "clause": "7.3.3",
                "standard": "unece-r155"
              },
              "shortDescription": {
                "text": "enable TLS certificate verification; never disable in production code"
              }
            },
            {
              "id": "CYBER014",
              "properties": {
                "category": "security",
                "clause": "FIO45-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "open the file directly and handle errors; avoid separate existence check"
              }
            },
            {
              "id": "CYBER015",
              "properties": {
                "category": "security",
                "clause": "FIO06-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "use restrictive permissions (e.g., 0o600 for user-only read/write)"
              }
            },
            {
              "id": "CYBER017",
              "properties": {
                "category": "security",
                "clause": "FIO02-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "call .canonicalize() after joining and verify path is within allowed root"
              }
            },
            {
              "id": "CYBER018",
              "properties": {
                "category": "security",
                "clause": "MEM31-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "document why ManuallyDrop is necessary and add //fusa:unsafe justification"
              }
            },
            {
              "id": "CYBER019",
              "properties": {
                "category": "security",
                "clause": "FIO30-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "use a string literal as the format template; pass dynamic content as arguments"
              }
            },
            {
              "id": "CYBER020",
              "properties": {
                "category": "security",
                "clause": "STR38-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "use std::str::from_utf8() which returns Result; only use unchecked variant with proof of valid UTF-8"
              }
            },
            {
              "id": "LINT001",
              "properties": {
                "category": "safety",
                "clause": "6.4.6",
                "standard": "iso26262"
              },
              "shortDescription": {
                "text": "add '//fusa:unsafe <justification>' on the line before the unsafe block"
              }
            },
            {
              "id": "LINT002",
              "properties": {
                "category": "safety"
              },
              "shortDescription": {
                "text": "replace .unwrap() with ? or .expect(\"rationale\") to provide context on failure"
              }
            },
            {
              "id": "LINT003",
              "properties": {
                "category": "safety"
              },
              "shortDescription": {
                "text": "resolve or convert to a tracked issue before final safety release"
              }
            },
            {
              "id": "LINT004",
              "properties": {
                "category": "safety",
                "clause": "EXP36-C",
                "standard": "cert-c"
              },
              "shortDescription": {
                "text": "add '//fusa:unsafe <justification>' and document why transmute is safe here"
              }
            },
            {
              "id": "LINT005",
              "properties": {
                "category": "safety"
              },
              "shortDescription": {
                "text": "replace with a Result return or add '//fusa:panic <justification>' if intentional"
              }
            }
          ],
          "version": "0.2.0"
        }
      }
    }
  ],
  "version": "2.1.0"
}
